# ── Django ──
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# домены, на которых работает приложение (через запятую)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
# полные origin'ы для CSRF (обязательно со схемой)
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# 1 — если раздаёте по HTTPS (secure cookies). Для локального http оставьте 0
DJANGO_COOKIE_SECURE=0

# ── Telegram ──
# токен и username бота от @BotFather (username без @)
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token
TELEGRAM_BOT_USERNAME=YourTrackerBot

# ── PostgreSQL ──
POSTGRES_DB=d4tracker
POSTGRES_USER=d4
POSTGRES_PASSWORD=change-me-too

# ── Порт, на котором наружу торчит приложение ──
APP_PORT=8080
